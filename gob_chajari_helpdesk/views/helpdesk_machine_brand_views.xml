<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Forms -->
  <record id="helpdesk_machine_brand_form_view" model="ir.ui.view">
    <field name="name">helpdesk.machine.brand.form.view</field>
    <field name="model">helpdesk.machine.brand</field>
    <field name="arch" type="xml">
      <form>
	<sheet>
	  <div class="oe_title">
	    <label for="name" string="Nombre"/>
	    <h1>
	      <field name="name"/>
	    </h1>
	  </div>
	  <notebook>
	    <page string="Tipo de equipos vendidos">
	      <field name="type_ids">
		<list>
		  <field name="name"/>
		</list>
	      </field>
	    </page>
	    <page string="Modelos comercializados">
	      <field name="model_ids">
		<list>
		  <field name="name"/>
		</list>
	      </field>
	    </page>
	  </notebook>
	</sheet>
      </form>
    </field>
  </record>

  <!-- Lists -->
  <record id="helpdesk_machine_brand_list_view" model="ir.ui.view">
    <field name="name">helpdesk.machine.brand.list.view</field>
    <field name="model">helpdesk.machine.brand</field>
    <field name="arch" type="xml">
      <list>
	<field name="name"/>
      </list>
    </field>
  </record>

  <!-- Actions -->
  <record id="helpdesk_machine_brand_action" model="ir.actions.act_window">
    <field name="name">Marcas</field>
    <field name="res_model">helpdesk.machine.brand</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_empty_folder">
	No existen marcas cargadas en el sistema
      </p>
    </field> 
  </record>
</odoo>
