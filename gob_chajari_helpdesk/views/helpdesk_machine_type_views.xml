<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Froms -->
  <record id="helpdesk_machine_type_form_view" model="ir.ui.view">
    <field name="name">helpdesk.machine.type.from.view</field>
    <field name="model">helpdesk.machine.type</field>
    <field name="arch" type="xml">
      <form string="Tipo de equipo">
	<sheet>
	  <div class="oe_title">
	    <label for="name" string="Nombre"/>
	    <h1>
	      <field name="name" placeholder="Ej: Epson, Lenovo, etc."/>
	    </h1>
	  </div>
	  <group>
	    <field name="technical_detail" widget="boolean_toggle"/>
	  </group>
	  <notebook>
	    <page string="Equipos">
	      <field name="machine_ids" readonly="1">
		<list>
		  <field name="name"/>
		</list>
	      </field>
	    </page>
	    <page string="Marcas">
	      <field name="brand_ids">
		<list>
		  <field name="name"/>
		</list>
	      </field>
	    </page>
	  </notebook>
	</sheet>
      </form>
    </field>
  </record>

  <!-- Lists -->
  <record id="helpdesk_machine_type_list_view" model="ir.ui.view">
    <field name="name">helpdesk.machine.type.list.view</field>
    <field name="model">helpdesk.machine.type</field>
    <field name="arch" type="xml">
      <list string="Tipos de equipo">
	<field name="name"/>
      </list>
    </field>
  </record>

  <!-- Actions -->
  <record id="helpdesk_machine_type_action" model="ir.actions.act_window">
    <field name="name">Tipos de equipo</field>
    <field name="res_model">helpdesk.machine.type</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_empty_folder">
	No existen tipos de equipo cargados
      </p>
      <p>
	Los tipos de equipos designan las características básicas de los
	equipos y contienen datos importantes que varian según el tipo
      </p>
    </field>
  </record>
</odoo>
