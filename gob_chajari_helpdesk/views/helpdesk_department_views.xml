<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Lists -->
  <record id="helpdesk_department_list_view" model="ir.ui.view">
    <field name="name">helpdesk.departement.list.view</field>
    <field name="model">helpdesk.department</field>
    <field name="arch" type="xml">
      <list editable="top">
	<field name="name"/>
      </list>
    </field>
  </record>

  <!-- Actions -->
  <record id="helpdesk_department_action" model="ir.actions.act_window">
    <field name="name">Oficinas</field>
    <field name="res_model">helpdesk.department</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_empty_folder">
	No existen oficinas cargadas
      </p>
      <p>
	Las oficinas son los lugares específicos en los que se encuentran
	los equipos. Cada edificio puede tener una o más oficinas con una cantidad
	arbitraria de equipos.
      </p>
    </field>
  </record>
</odoo>
