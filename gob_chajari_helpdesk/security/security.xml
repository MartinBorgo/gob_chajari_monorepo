<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Category -->
  <record id="module_category_helpdesk" model="ir.module.category">
    <field name="name">Soporte técnico</field>
    <field name="sequence">10</field>
  </record>
  
  <!-- Privilege group -->
  <record id="privilege_helpdesk" model="res.groups.privilege">
    <field name="name">Soporte técnico</field>
    <field name="category_id" ref="module_category_helpdesk"/>
    <field name="sequence">10</field>
  </record>
  
  <!-- Groups -->
  <record id="group_helpdesk_admin" model="res.groups">
    <field name="name">Administrador</field>
    <field name="comment">El usuario tendrá acceso y control sobre la totalidad de los objetos de la aplicación</field>
    <field name="privilege_id" ref="privilege_helpdesk"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
  </record>
  
  <record id="group_helpdesk_readonly" model="res.groups">
    <field name="name">Usuario / Solo lectura</field>
    <field name="comment">El usuario solo podrá leer todos los objetos del módulo</field>
    <field name="privilege_id" ref="privilege_helpdesk"/>
  </record>
</odoo>
